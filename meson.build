# ==============================================================================
# CactWayland-x86_64 — the Wayland protocol libraries for CactOS
# ==============================================================================
#
# Upstream sources are carried in place, but the build system is CactOS's own:
# upstream's meson.build / meson_options.txt are removed (see UPSTREAM.md) and
# only the four libraries are built, each into its own loader base
#
#   libwayland-client.so  0x24000000
#   libwayland-server.so  0x25000000
#   libwayland-egl.so     0x26000000
#   libwayland-cursor.so  0x27000000
#
#   meson setup build-meson --cross-file cross/x86_64-cact-clang.ini
#   ninja -C build-meson            # the four .so files
#   ninja -C build-meson stage      # into LocalRepo (lib/, include/)
#   ninja -C build-meson pkg        # repo/wayland-<ver>.cpkg
#
# The protocol code is generated by wayland-scanner, which runs on the *build*
# machine (the host carries the same 1.26.0 as the pin), so no scanner is built
# here.  libwayland-client/server include <ffi.h> and call ffi_call() — that is
# CactFFI, whose staged headers and .so this port builds against (stage it first;
# the workspace integrator does).
# ==============================================================================

project('cact-wayland', 'c',
  version: '1.26.0',
  meson_version: '>=1.0.0',
  default_options: [
    'c_std=gnu99',
    'warning_level=0',            # wayland is vendored; -w below
    'buildtype=plain',
    'b_staticpic=false',
  ])

fs = import('fs')
bash = find_program('bash')
ld = find_program('ld')
python3 = find_program('python3')
scanner = find_program('wayland-scanner')

src_root = meson.project_source_root()
build_root = meson.current_build_dir()

_cactlib = get_option('cactlib')
cactlib = _cactlib.startswith('/') ? _cactlib : src_root / _cactlib
_ffiinc = get_option('ffiinc')
ffiinc = _ffiinc.startswith('/') ? _ffiinc : src_root / _ffiinc
_lr_lib = get_option('lr_lib')
lr_lib = _lr_lib.startswith('/') ? _lr_lib : src_root / _lr_lib
_cpkg_py = get_option('cpkg_py')
cpkg_py = _cpkg_py.startswith('/') ? _cpkg_py : src_root / _cpkg_py

cactlib_inc = cactlib / 'include'
if not fs.is_dir(cactlib_inc)
  error('CactLibc headers not found at ' + cactlib_inc +
        '  —  checkout the sibling repo or pass -Dcactlib=<path>')
endif
if not fs.is_file(ffiinc / 'ffi.h')
  error('ffi.h not found in ' + ffiinc +
        '  —  build and stage CactFFI first (ninja -C ../CactFFI-x86_64/build-meson stage)')
endif
# The staged libffi.so next to those headers: libwayland-client/server call into
# it, so their link has to record a DT_NEEDED on it.
ffi_so = ffiinc / '..' / 'libffi.so'

# ------------------------------------------------------------------------------
# Generated sources: the version header, the protocol, the linker scripts
# ------------------------------------------------------------------------------

_ver = meson.project_version().split('.')
_version_conf = configuration_data()
_version_conf.set('WAYLAND_VERSION', meson.project_version())
_version_conf.set('WAYLAND_VERSION_MAJOR', _ver[0])
_version_conf.set('WAYLAND_VERSION_MINOR', _ver[1])
_version_conf.set('WAYLAND_VERSION_MICRO', _ver[2])
wayland_version_h = configure_file(input: 'src/wayland-version.h.in',
                                   output: 'wayland-version.h',
                                   configuration: _version_conf)

# Every generated file comes from protocol/wayland.xml.  The `-c` variants are
# the core-only headers the libraries themselves use (upstream installs only the
# full ones).
proto_xml = 'protocol/wayland.xml'
server_proto_h = custom_target('wayland-server-protocol.h', input: proto_xml,
  output: 'wayland-server-protocol.h',
  command: [scanner, 'server-header', '@INPUT@', '@OUTPUT@'])
server_proto_core_h = custom_target('wayland-server-protocol-core.h', input: proto_xml,
  output: 'wayland-server-protocol-core.h',
  command: [scanner, 'server-header', '-c', '@INPUT@', '@OUTPUT@'])
client_proto_h = custom_target('wayland-client-protocol.h', input: proto_xml,
  output: 'wayland-client-protocol.h',
  command: [scanner, 'client-header', '@INPUT@', '@OUTPUT@'])
client_proto_core_h = custom_target('wayland-client-protocol-core.h', input: proto_xml,
  output: 'wayland-client-protocol-core.h',
  command: [scanner, 'client-header', '-c', '@INPUT@', '@OUTPUT@'])
protocol_c = custom_target('wayland-protocol.c', input: proto_xml,
  output: 'wayland-protocol.c',
  command: [scanner, 'public-code', '@INPUT@', '@OUTPUT@'])

# One linker script per library, from the shared template.
_ld_client = configuration_data()
_ld_client.set('base', '0x24000000')
ld_client = configure_file(input: 'wayland.ld.in', output: 'wayland-client.ld',
                           configuration: _ld_client)
_ld_server = configuration_data()
_ld_server.set('base', '0x25000000')
ld_server = configure_file(input: 'wayland.ld.in', output: 'wayland-server.ld',
                           configuration: _ld_server)
_ld_egl = configuration_data()
_ld_egl.set('base', '0x26000000')
ld_egl = configure_file(input: 'wayland.ld.in', output: 'wayland-egl.ld',
                        configuration: _ld_egl)
_ld_cursor = configuration_data()
_ld_cursor.set('base', '0x27000000')
ld_cursor = configure_file(input: 'wayland.ld.in', output: 'wayland-cursor.ld',
                           configuration: _ld_cursor)

# ------------------------------------------------------------------------------
# Compile and link
# ------------------------------------------------------------------------------

# -nostdlibinc: the host libc's headers are not searched at all (clang's builtin
# stdarg.h and friends still are), so a header CactLibc lacks is a hard error
# instead of a silent grab of the host glibc's copy.  -fvisibility=hidden plus
# the headers' WL_EXPORT keeps the exported surface the public API, as upstream
# does.  -w: wayland is vendored third-party code.
wayland_c_args = [
  '-ffreestanding', '-fno-stack-protector', '-nostdlib', '-nostdlibinc',
  '-D__CACT__', '-D_POSIX_C_SOURCE=200809L', '-fvisibility=hidden',
  '-I' + src_root,
  '-I' + src_root / 'src',
  '-I' + build_root,            # generated protocol / version headers
  '-isystem', cactlib_inc,
  '-isystem', ffiinc,
  '-w',
]

_link = [ld, '-m', 'elf_x86_64', '-shared', '-nostdlib', '--hash-style=both']

# wayland-util.c / connection.c / wayland-os.c go into both library-side
# libraries (upstream links them in as static "wayland-util" / "wayland-private"
# libraries); -fvisibility=hidden keeps that duplication out of the symbol table.
private_srcs = files('src/wayland-util.c', 'src/connection.c', 'src/wayland-os.c')

client_obj = static_library('wayland-client-obj',
  [files('src/wayland-client.c'), private_srcs, protocol_c,
   client_proto_h, client_proto_core_h],
  c_args: wayland_c_args, pic: true)
libwayland_client_so = custom_target('libwayland-client.so',
  input: client_obj, output: 'libwayland-client.so',
  command: _link + ['-soname=libwayland-client.so', '-T', ld_client,
                    '-o', '@OUTPUT@', '--whole-archive', client_obj,
                    '--no-whole-archive', ffi_so],
  build_by_default: true)

server_obj = static_library('wayland-server-obj',
  [files('src/wayland-server.c', 'src/wayland-shm.c', 'src/event-loop.c'),
   private_srcs, protocol_c, server_proto_h, server_proto_core_h],
  c_args: wayland_c_args, pic: true)
libwayland_server_so = custom_target('libwayland-server.so',
  input: server_obj, output: 'libwayland-server.so',
  command: _link + ['-soname=libwayland-server.so', '-T', ld_server,
                    '-o', '@OUTPUT@', '--whole-archive', server_obj,
                    '--no-whole-archive', ffi_so],
  build_by_default: true)

# wayland-egl and wayland-cursor are thin: they call into libwayland-client, so
# their link records a DT_NEEDED on it (the loader maps it from /usr/lib).
egl_obj = static_library('wayland-egl-obj',
  [files('egl/wayland-egl.c'), client_proto_h],
  c_args: wayland_c_args, pic: true)
libwayland_egl_so = custom_target('libwayland-egl.so',
  input: egl_obj, output: 'libwayland-egl.so',
  command: _link + ['-soname=libwayland-egl.so', '-T', ld_egl,
                    '-o', '@OUTPUT@', '--whole-archive', egl_obj,
                    '--no-whole-archive', libwayland_client_so],
  build_by_default: true)

cursor_obj = static_library('wayland-cursor-obj',
  files('cursor/wayland-cursor.c', 'cursor/os-compatibility.c', 'cursor/xcursor.c'),
  c_args: wayland_c_args + ['-DICONDIR="/usr/share/icons"'], pic: true)
libwayland_cursor_so = custom_target('libwayland-cursor.so',
  input: cursor_obj, output: 'libwayland-cursor.so',
  command: _link + ['-soname=libwayland-cursor.so', '-T', ld_cursor,
                    '-o', '@OUTPUT@', '--whole-archive', cursor_obj,
                    '--no-whole-archive', libwayland_client_so],
  build_by_default: true)

# ------------------------------------------------------------------------------
# Stage into the image tree and build the package
# ------------------------------------------------------------------------------

# The public headers, flat in /usr/include — the layout the libraries are
# included by (<wayland-client.h>, <wayland-client-protocol.h>, ...).
# The lists below are index-aligned: source file, then installed name.
_srcs = [libwayland_client_so, libwayland_server_so,
         libwayland_egl_so, libwayland_cursor_so,
         files('src/wayland-client.h'), files('src/wayland-client-core.h'),
         files('src/wayland-server.h'), files('src/wayland-server-core.h'),
         files('src/wayland-util.h'),
         files('egl/wayland-egl.h'), files('egl/wayland-egl-core.h'),
         files('egl/wayland-egl-backend.h'), files('cursor/wayland-cursor.h'),
         client_proto_h, server_proto_h, wayland_version_h]
_dsts = ['libwayland-client.so', 'libwayland-server.so',
         'libwayland-egl.so', 'libwayland-cursor.so',
         'wayland-client.h', 'wayland-client-core.h',
         'wayland-server.h', 'wayland-server-core.h', 'wayland-util.h',
         'wayland-egl.h', 'wayland-egl-core.h', 'wayland-egl-backend.h',
         'wayland-cursor.h',
         'wayland-client-protocol.h', 'wayland-server-protocol.h',
         'wayland-version.h']

# Everything lands either directly in the lib dir (the .so files) or in its
# include/ (the headers).  @ROOT@ is what each target substitutes: LocalRepo's
# lib dir, or the package payload dir.  The source paths are passed as command
# arguments (so ninja knows `stage` depends on the built files); $0 is the
# explicit "bash" placeholder, hence the sources start at $1.
_copy = 'set -e; mkdir -p "@ROOT@" "@ROOT@/include"; '
_i = 0
foreach s : _srcs
  # The first four entries are the shared objects (they land in the lib dir);
  # the rest are headers (they land in its include/).  ${…} braces: a bare $10
  # is read by the shell as $1 followed by "0".
  _dest = (_i < 4) ? '@ROOT@/' + _dsts[_i] : '@ROOT@/include/' + _dsts[_i]
  _copy += 'cp -f "${' + (_i + 1).to_string() + '}" "' + _dest + '"; '
  _i += 1
endforeach

run_target('stage',
  command: [bash, '-c', _copy.replace('@ROOT@', lr_lib), 'bash'] + _srcs)

_pkg_dir = src_root / 'pkg' / 'wayland'
_pkg_repo = src_root / 'repo'

run_target('pkg',
  command: [bash, '-c',
            'rm -rf "' + _pkg_dir + '/payload"; ' +
            _copy.replace('@ROOT@', _pkg_dir / 'payload') +
            python3.full_path() + ' "' + cpkg_py + '" build "' + _pkg_dir +
            '" --repo "' + _pkg_repo + '"; ' +
            python3.full_path() + ' "' + cpkg_py + '" index "' + _pkg_repo + '"',
            'bash'] + _srcs)
